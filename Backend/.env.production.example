NODE_ENV=production
PORT=4000
API_VERSION=v1
APP_VERSION=1.0.0

# Example: https://roomzly.web.app or https://roomzly.com
FRONTEND_URL=https://YOUR_FIREBASE_HOSTING_DOMAIN
ADDITIONAL_CORS_ORIGINS=

# Railway injects this from the PostgreSQL service.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Use Railway Redis, Upstash, or another managed Redis URL.
REDIS_URL=rediss://YOUR_REDIS_URL

JWT_ACCESS_SECRET=GENERATE_A_32_PLUS_CHARACTER_RANDOM_SECRET
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_32_PLUS_CHARACTER_RANDOM_SECRET

# Leave COOKIE_DOMAIN empty for Railway/Firebase default hostnames.
# Set COOKIE_DOMAIN=.roomzly.com only after both frontend and API use the roomzly.com parent domain.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_FROM=Roomzly <noreply@roomzly.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

